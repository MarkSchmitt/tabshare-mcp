  "license": "MIT",
  "keywords": ["firefox", "browser", "mcp", "tabs", "automation"],
  "mcpServers": {
    "firefox-tabs": {
      "command": "node",
      "args": ["${CLAUDE_PLUGIN_ROOT}/server/mcp-server.js"]
    }
  }
}
